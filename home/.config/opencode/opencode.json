{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "mcp": {
    "railway": {
      "command": [
        "railway",
        "mcp",
        "proxy"
      ],
      "enabled": true,
      "type": "local"
    },
    "agent-browser": {
      "command": [
        "agent-browser",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": [
    "opencode-wakatime"
  ],
  "permission": "allow",
  "theme": "system"
}
